// =============================================================================
// PRISMA SCHEMA — E-Learning Tập đoàn (v4 · 21 bảng)
//
// Nguyên tắc thiết kế:
//   1. Quản trị 2 cấp: Công ty tổng đặt chuẩn chung, công ty con tự quản phần riêng.
//      Mọi dữ liệu "sở hữu được" (khoá học, lộ trình, quy tắc giao) đều có ownerCompanyId.
//   2. Quy trình có phiên bản: khoá học có currentVersion; lượt học ghi lại phiên bản
//      người học đã hoàn thành / đã xác nhận -> biết chính xác ai đã nắm quy trình mới.
//   3. Tài khoản do admin tạo (thủ công / import Excel). Các cột lark* để sẵn cho
//      giai đoạn 2 (đồng bộ Lark), phase 1 để trống.
//   4. Không xoá dữ liệu nghiệp vụ, chỉ đổi trạng thái. Mọi thao tác quản trị ghi audit_logs.
//
// Quy tắc nghiệp vụ: docs/database.md
// v4 so với v3: trưởng phòng (departments.managerId), ngân hàng câu hỏi theo khoá học,
//   đề xuất phiên bản MAJOR, mẫu chứng nhận theo công ty, bảng system_settings,
//   mã phòng ban duy nhất trong từng công ty, mật khẩu bắt buộc.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUM
// =============================================================================

/// Vai trò. Phạm vi quyền = công ty của người đó (users.companyId).
enum Role {
  GROUP_ADMIN    // Quản trị tập đoàn (thuộc công ty tổng): toàn quyền, thấy mọi công ty
  COMPANY_ADMIN  // Quản trị đào tạo công ty con
  CONTENT_EDITOR // Biên soạn nội dung của công ty mình
  MANAGER        // Trưởng phòng: xem tiến độ các phòng mình phụ trách (gồm phòng con)
  LEARNER        // Nhân viên
}

enum UserStatus {
  ACTIVE   // Đang làm việc
  INACTIVE // Đã khoá / nghỉ việc: không đăng nhập, giữ nguyên lịch sử học
}

/// Đối tượng học — 3 module của dự án (nhân viên làm trước)
enum Audience {
  EMPLOYEE
  PARTNER
  CUSTOMER
}

enum CourseStatus {
  DRAFT     // Đang soạn lần đầu, học viên chưa thấy
  PUBLISHED // Đang dùng
  ARCHIVED  // Ngừng dùng
}

/// Loại thay đổi khi phát hành phiên bản
enum ChangeType {
  INITIAL // Phát hành lần đầu (phiên bản 1)
  MAJOR   // Thay đổi lớn: người đã học phải HỌC LẠI và làm lại bài kiểm tra
  MINOR   // Thay đổi nhỏ: người đã học chỉ cần ĐỌC PHẦN THAY ĐỔI và bấm xác nhận
}

/// Trạng thái một phiên bản. Biên soạn chỉ được ĐỀ XUẤT bản MAJOR, admin duyệt.
enum VersionStatus {
  PROPOSED  // Biên soạn đề xuất, chờ admin duyệt (chỉ dùng cho MAJOR)
  PUBLISHED // Đã phát hành
  REJECTED  // Admin từ chối đề xuất
}

enum LessonType {
  VIDEO
  DOCUMENT
  QUIZ
}

/// Nguồn video của bài VIDEO (không lưu file video trên server)
enum VideoProvider {
  YOUTUBE // Video "Không công khai" trên YouTube — ai có link đều xem được
  BUNNY   // Bunny Stream — phát bằng iframe có token hết hạn
}

/// Trạng thái video (Bunny cần thời gian xử lý sau khi tải lên)
enum VideoStatus {
  PROCESSING
  READY
  FAILED
}

enum EnrollmentSource {
  RULE     // Bắt buộc: tự động theo quy tắc (công ty / phòng ban / chức danh)
  ASSIGNED // Được giao: quản trị giao tay cho từng người
  SELF     // Tự đăng ký từ thư viện
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED // Quản trị huỷ giao
}

enum QuestionType {
  SINGLE   // 1 đáp án đúng
  MULTIPLE // Nhiều đáp án đúng
}

// =============================================================================
// NHÓM 1 — TỔ CHỨC (3 bảng)
// =============================================================================

/// Công ty tổng: parentId = NULL. Công ty con: parentId = id công ty tổng.
model Company {
  id        String  @id @default(cuid())
  code      String  @unique // VD: TONG, CTY-A
  name      String
  parentId  String?
  isActive  Boolean @default(true)

  // --- Mẫu chứng nhận của công ty (để trống = dùng mẫu của công ty tổng) ---
  logoUrl                 String?
  certificateSignerName   String? // Người ký, VD: Nguyễn Văn A
  certificateSignerTitle  String? // Chức vụ, VD: Giám đốc nhân sự
  certificateSignatureUrl String? // Ảnh chữ ký

  /// Đồng bộ Lark (Việc L1): phòng ban GỐC trên Lark (open_department_id) ứng với công ty này — mọi phòng / người dưới nhánh đó thuộc công ty này
  larkDepartmentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent          Company?         @relation("CompanyTree", fields: [parentId], references: [id])
  subsidiaries    Company[]        @relation("CompanyTree")
  departments     Department[]
  users           User[]
  ownedCourses    Course[]
  ownedPaths      LearningPath[]
  ownedRules      AssignmentRule[] @relation("RuleOwner")
  targetedByRules AssignmentRule[] @relation("RuleTargetCompany")

  @@map("companies")
}

/// Phòng ban — lồng nhau được (Phòng > Nhóm > Tổ). Mỗi phòng có 1 trưởng phòng.
model Department {
  id               String   @id @default(cuid())
  companyId        String
  parentId         String?
  managerId        String? // Trưởng phòng (user có vai trò MANAGER trở lên)
  code             String // Duy nhất trong công ty, VD: KD, KT
  name             String
  larkDepartmentId String?  @unique // Giai đoạn 2: mã phòng ban bên Lark
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  parent          Department?      @relation("DepartmentTree", fields: [parentId], references: [id])
  children        Department[]     @relation("DepartmentTree")
  manager         User?            @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  users           User[]           @relation("DepartmentMembers")
  assignmentRules AssignmentRule[]

  @@unique([companyId, code])
  @@index([parentId])
  @@index([managerId])
  @@map("departments")
}

/// Chức danh — dùng chung toàn tập đoàn.
model Position {
  id        String   @id @default(cuid())
  code      String   @unique // VD: NVKD
  name      String // VD: Nhân viên kinh doanh
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users           User[]
  assignmentRules AssignmentRule[]

  @@map("positions")
}

// =============================================================================
// NHÓM 2 — NGƯỜI DÙNG (1 bảng)
// =============================================================================

model User {
  id                 String     @id @default(cuid())
  employeeCode       String     @unique // Mã nhân viên = tên đăng nhập, duy nhất toàn tập đoàn
  passwordHash       String // bcrypt. Admin đặt mật khẩu ban đầu
  mustChangePassword Boolean    @default(true) // true = bắt đổi mật khẩu ở lần đăng nhập tới
  fullName           String
  email              String?
  phone              String?
  avatarUrl          String?
  role               Role       @default(LEARNER)
  status             UserStatus @default(ACTIVE)
  audience           Audience   @default(EMPLOYEE)
  companyId          String
  departmentId       String?
  positionId         String?
  hireDate           DateTime?  @db.Date
  larkUserId         String?    @unique // Giai đoạn 2: mã nhân viên bên Lark
  lastLoginAt        DateTime?
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime? // Khoá tạm sau nhiều lần sai mật khẩu
  sessionsValidAfter DateTime? // Phiên đăng nhập cấp TRƯỚC thời điểm này bị huỷ (đổi / đặt lại mật khẩu, khoá, đổi vai trò, chuyển công ty)
  /// false = chưa có mật khẩu riêng (tài khoản tạo từ đồng bộ Lark): đăng nhập bằng mật khẩu luôn báo sai, đến khi admin đặt lại mật khẩu
  passwordSet        Boolean    @default(true)
  /// Ai đã khoá tài khoản: "LARK" (đồng bộ thấy nghỉ việc / không còn trên Lark — tự mở lại khi Lark báo đang làm) | "ADMIN" (quản trị khoá — không tự mở)
  inactiveSource     String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  company    Company     @relation(fields: [companyId], references: [id])
  department Department? @relation("DepartmentMembers", fields: [departmentId], references: [id])
  position   Position?   @relation(fields: [positionId], references: [id])

  managedDepartments Department[]     @relation("DepartmentManager")
  enrollments        Enrollment[]     @relation("Learner")
  assignedByMe       Enrollment[]     @relation("AssignedBy")
  lessonProgress     LessonProgress[]
  quizAttempts       QuizAttempt[]
  certificates       Certificate[]
  reviews            CourseReview[]
  notifications      Notification[]
  proposedVersions   CourseVersion[]  @relation("VersionProposedBy")
  publishedVersions  CourseVersion[]  @relation("VersionPublishedBy")
  auditLogs          AuditLog[]

  @@index([companyId, status])
  @@index([departmentId])
  @@map("users")
}

// =============================================================================
// NHÓM 3 — NỘI DUNG (7 bảng)
// Danh mục > Khoá học (có phiên bản) > Chương > Bài học. Lộ trình gom nhiều khoá.
// =============================================================================

model CourseCategory {
  id        String   @id @default(cuid())
  name      String   @unique // VD: Văn hoá – Nội quy, Quy trình, Kỹ năng, An toàn
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  courses Course[]

  @@map("course_categories")
}

/// Khoá học. ownerCompanyId = công ty tổng -> dùng cho cả tập đoàn;
/// = công ty con -> chỉ công ty đó thấy và dùng.
model Course {
  id                     String       @id @default(cuid())
  ownerCompanyId         String
  categoryId             String?
  code                   String       @unique // VD: QT-BH-01
  title                  String
  description            String?
  thumbnailUrl           String?
  audience               Audience     @default(EMPLOYEE)
  status                 CourseStatus @default(DRAFT)
  currentVersion         Int          @default(0) // 0 = chưa phát hành lần nào
  allowSelfEnroll        Boolean      @default(false)
  hasCertificate         Boolean      @default(false)
  certificateValidMonths Int? // NULL = vĩnh viễn; 12 = phải học lại hằng năm
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  ownerCompany    Company              @relation(fields: [ownerCompanyId], references: [id])
  category        CourseCategory?      @relation(fields: [categoryId], references: [id])
  versions        CourseVersion[]
  sections        CourseSection[]
  questions       Question[]
  pathCourses     LearningPathCourse[]
  assignmentRules AssignmentRule[]
  enrollments     Enrollment[]
  certificates    Certificate[]
  reviews         CourseReview[]

  @@index([ownerCompanyId, status])
  @@map("courses")
}

/// Lịch sử phát hành — bằng chứng "quy trình đổi lúc nào, đổi gì, ai đề xuất, ai phát hành".
model CourseVersion {
  id            String        @id @default(cuid())
  courseId      String
  versionNo     Int? // Gán khi PHÁT HÀNH (1, 2, 3...). Đề xuất chưa duyệt = NULL
  changeType    ChangeType
  status        VersionStatus @default(PUBLISHED)
  changeSummary String? // Tóm tắt thay đổi (HTML) — người học đọc khi xác nhận bản MINOR
  dueInDays     Int? // Hạn học lại / xác nhận, tính từ ngày phát hành
  proposedById  String? // Biên soạn đề xuất (bản MAJOR)
  proposedAt    DateTime?
  publishedById String?
  publishedAt   DateTime?
  reviewNote    String? // Admin ghi lý do khi từ chối đề xuất
  createdAt     DateTime      @default(now())

  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  proposedBy  User?  @relation("VersionProposedBy", fields: [proposedById], references: [id], onDelete: SetNull)
  publishedBy User?  @relation("VersionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([courseId, versionNo])
  @@index([courseId, status])
  @@map("course_versions")
}

model CourseSection {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  sortOrder Int      @default(0)
  // Khoá đã phát hành: không xoá hẳn, chỉ ẩn (học viên không thấy, giữ lịch sử học)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, sortOrder])
  @@map("course_sections")
}

/// Bài học. Học theo thứ tự (chương rồi bài). Mỗi loại bài dùng nhóm cột riêng.
model Lesson {
  id        String     @id @default(cuid())
  sectionId String
  title     String
  type      LessonType
  sortOrder Int        @default(0)
  // Khoá đã phát hành: không xoá hẳn, chỉ ẩn (không tính vào tiến độ, giữ lesson_progress / quiz_attempts)
  isArchived Boolean   @default(false)

  // --- VIDEO ---
  videoProvider   VideoProvider?
  videoId         String? // YouTube: mã 11 ký tự; Bunny: guid video
  videoStatus     VideoStatus?
  durationSeconds Int?
  minWatchPercent Int     @default(90) // Xem đủ % mới tính hoàn thành
  // Bunny: video đã tạo trên Bunny, ĐANG tải lên, chưa gắn vào bài (Việc 31B, security-review #8).
  // Vé tải lên chỉ hợp lệ khi đúng id này (dùng 1 lần); quá 24 giờ chưa xong → tác vụ hằng ngày xoá trên Bunny.
  pendingVideoId        String?
  pendingVideoCreatedAt DateTime?

  // --- DOCUMENT ---
  content  String? // Nội dung bài đọc (HTML)
  fileUrl  String? // File đính kèm (PDF quy trình...)
  fileName String?

  // --- QUIZ: rút câu hỏi từ ngân hàng câu hỏi của khoá học ---
  questionTopic    String? // Chỉ rút câu có topic này; NULL = rút từ toàn bộ ngân hàng của khoá
  questionCount    Int? // Số câu rút ngẫu nhiên mỗi lần làm
  passingScore     Int? // Điểm đạt, thang 100
  timeLimitMinutes Int?
  maxAttempts      Int? // NULL = không giới hạn
  showAnswers      Boolean @default(false) // Cho xem đáp án đúng sau khi nộp

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section      CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress     LessonProgress[]
  quizAttempts QuizAttempt[]

  @@index([sectionId, sortOrder])
  @@index([videoId]) // Webhook Bunny tra bài theo guid video
  @@map("lessons")
}

model LearningPath {
  id             String       @id @default(cuid())
  ownerCompanyId String
  code           String       @unique
  title          String // VD: Hội nhập 30 ngày – Kinh doanh
  description    String?
  status         CourseStatus @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  ownerCompany    Company              @relation(fields: [ownerCompanyId], references: [id])
  courses         LearningPathCourse[]
  assignmentRules AssignmentRule[]
  enrollments     Enrollment[]

  @@map("learning_paths")
}

/// Lộ trình gồm khoá nào, thứ tự nào. Học tuần tự: xong khoá trước mới mở khoá sau.
model LearningPathCourse {
  learningPathId String
  courseId       String
  sortOrder      Int    @default(0)

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([learningPathId, courseId])
  @@map("learning_path_courses")
}

// =============================================================================
// NHÓM 4 — KIỂM TRA (2 bảng)
// =============================================================================

/// Ngân hàng câu hỏi: mỗi câu thuộc 1 khoá học, gắn chủ đề (topic) để lọc.
/// Bài QUIZ của khoá rút ngẫu nhiên lessons.questionCount câu từ đây.
model Question {
  id          String       @id @default(cuid())
  courseId    String
  topic       String? // Chủ đề, VD: "Quy trình nhận hàng"
  type        QuestionType
  content     String
  imageUrl    String?
  options     Json // [{ "id": "a", "text": "...", "isCorrect": true }, ...]
  explanation String?
  isActive    Boolean      @default(true) // false = không rút vào đề nữa
  isAiCreated Boolean      @default(false) // Giai đoạn 2
  isApproved  Boolean      @default(true) // Câu AI tạo phải được duyệt mới dùng
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, topic, isActive, isApproved])
  @@map("questions")
}

/// Một lần làm bài. answers lưu nguyên đề + câu trả lời tại thời điểm làm.
model QuizAttempt {
  id            String    @id @default(cuid())
  lessonId      String
  userId        String
  courseVersion Int // Làm ở phiên bản khoá học nào
  attemptNo     Int // Lần thứ mấy TRONG phiên bản đó
  answers       Json // [{ questionId, content, options, selected: ["a"], isCorrect }]
  score         Int? // NULL = đang làm
  passed        Boolean?
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId, courseVersion, attemptNo])
  @@map("quiz_attempts")
}

// =============================================================================
// NHÓM 5 — GIAO KHOÁ & TIẾN ĐỘ (3 bảng)
// =============================================================================

/// Quy tắc bắt buộc: "ai thì phải học gì, trong bao lâu".
/// ownerCompanyId = công ty tổng: áp dụng được cho mọi công ty.
/// ownerCompanyId = công ty con: chỉ áp dụng trong công ty đó.
/// Các điều kiện kết hợp kiểu VÀ; để NULL = không lọc.
model AssignmentRule {
  id                    String   @id @default(cuid())
  ownerCompanyId        String
  name                  String
  courseId              String? // Giao 1 khoá...
  learningPathId        String? // ...hoặc 1 lộ trình
  targetCompanyId       String?
  departmentId          String?
  includeSubDepartments Boolean  @default(true)
  positionId            String?
  dueInDays             Int?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  ownerCompany  Company       @relation("RuleOwner", fields: [ownerCompanyId], references: [id])
  targetCompany Company?      @relation("RuleTargetCompany", fields: [targetCompanyId], references: [id])
  course        Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learningPath  LearningPath? @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  department    Department?   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  position      Position?     @relation(fields: [positionId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]

  @@index([isActive])
  @@map("assignment_rules")
}

/// Lượt học: "người X phải học / đang học khoá Y". Mỗi người – mỗi khoá 1 dòng,
/// dùng lại khi học lại (phiên bản mới, chứng nhận hết hạn).
model Enrollment {
  id                  String           @id @default(cuid())
  userId              String
  courseId            String
  source              EnrollmentSource
  assignedById        String?
  assignmentRuleId    String?
  learningPathId      String?
  status              EnrollmentStatus @default(NOT_STARTED)
  progressPercent     Int              @default(0)
  dueDate             DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  // --- Phiên bản ---
  completedVersion    Int? // Phiên bản gần nhất người này đã HỌC XONG
  acknowledgedVersion Int? // Phiên bản gần nhất người này đã NẮM (học xong hoặc xác nhận bản MINOR)
  acknowledgedAt      DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user           User            @relation("Learner", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy     User?           @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignmentRule AssignmentRule? @relation(fields: [assignmentRuleId], references: [id], onDelete: SetNull)
  learningPath   LearningPath?   @relation(fields: [learningPathId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@index([status, dueDate])
  @@map("enrollments")
}

/// Tiến độ từng bài. Khi học lại (bản MAJOR) các dòng của khoá đó được đặt lại.
model LessonProgress {
  id                  String    @id @default(cuid())
  userId              String
  lessonId            String
  isCompleted         Boolean   @default(false)
  lastPositionSeconds Int       @default(0) // Video: xem tiếp từ đây
  maxWatchedSeconds   Int       @default(0) // Video: đã xem thật tới đâu (chống tua)
  bonusAttempts       Int       @default(0) // Bài kiểm tra: lượt làm thêm do admin cấp (tối đa = maxAttempts + bonusAttempts)
  completedAt         DateTime?
  updatedAt           DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  // Việc 30: "Lần học gần nhất" (MAX(updatedAt) theo người — báo cáo Theo người), "Người học 30 ngày" (Dashboard tập đoàn),
  // "Tiếp tục học" (bài dở mới nhất của 1 người) → index-only scan thay vì quét cả bảng
  @@index([userId, updatedAt])
  @@map("lesson_progress")
}

// =============================================================================
// NHÓM 6 — KẾT QUẢ & PHẢN HỒI (2 bảng)
// =============================================================================

model Certificate {
  id            String    @id @default(cuid())
  code          String    @unique // VD: CERT-2026-000123 — dùng để tra cứu
  userId        String
  courseId      String?
  courseVersion Int // Cấp cho phiên bản nào
  recipientName String // Tên tại thời điểm cấp
  courseTitle   String
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime? // Thu hồi (VD: phát hiện gian lận)
  /// Mẫu tại thời điểm cấp: { companyName, logoKey, signerName, signerTitle, signatureKey } — sửa mẫu sau không đổi chứng nhận đã cấp
  templateSnapshot Json?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("certificates")
}

model CourseReview {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  rating    Int // 1 - 5 sao
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@map("course_reviews")
}

// =============================================================================
// NHÓM 7 — HỆ THỐNG (3 bảng)
// =============================================================================

model Notification {
  id           String    @id @default(cuid())
  userId       String
  type         String // COURSE_ASSIGNED, VERSION_MAJOR, VERSION_MINOR, DUE_SOON, OVERDUE, REMINDER, CERTIFICATE_ISSUED, CERTIFICATE_EXPIRING...
  title        String
  link         String?
  readAt       DateTime?
  sentToLarkAt DateTime? // Đã gửi tin nhắn Lark thành công (Việc L2)
  /// Gửi qua Lark (Việc L2): null = không thuộc diện gửi; PENDING (chờ gửi / chờ thử lại) / SENT / SKIPPED (chưa liên kết Lark, loại đã tắt…) / FAILED
  larkStatus        String?
  larkAttempts      Int       @default(0)
  larkNextAttemptAt DateTime?
  larkError         String? // Lý do lỗi / bỏ qua gần nhất (≤ 300 ký tự)
  dedupeKey    String? // Chống gửi trùng: cùng userId + dedupeKey chỉ có 1 dòng (NULL = không chống trùng)
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([larkStatus, larkNextAttemptAt]) // Bộ gửi Lark lấy tin chờ gửi
  @@index([userId, readAt])
  @@map("notifications")
}

/// Ai làm gì, lúc nào — bắt buộc khi có nhiều cấp quản trị.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // NULL = hệ thống tự làm (quy tắc giao, tác vụ hằng ngày...)
  companyId  String? // Thao tác thuộc công ty nào (để lọc theo phạm vi)
  action     String // VD: COURSE_VERSION_PUBLISHED, USER_CREATED
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([companyId, createdAt])
  @@index([createdAt]) // Nhật ký toàn hệ thống theo khoảng ngày (Admin tập đoàn)
  @@index([actorId, createdAt]) // Thao tác do 1 người làm (trang chi tiết người dùng)
  @@map("audit_logs")
}

/// Cài đặt chung toàn hệ thống (Admin tập đoàn chỉnh).
/// Key dùng: SYSTEM_NAME, SYSTEM_LOGO_URL, DEFAULT_DUE_DAYS, DEFAULT_MIN_WATCH_PERCENT...
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
