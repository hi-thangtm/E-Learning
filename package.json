{
  "name": "e-learning",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "job:daily": "tsx --require ./scripts/allow-server-only.cjs --env-file=.env scripts/run-daily-job.ts",
    "job:lark-sync": "tsx --require ./scripts/allow-server-only.cjs --env-file=.env scripts/run-lark-sync.ts",
    "job:backfill-certificates": "tsx --require ./scripts/allow-server-only.cjs --env-file=.env scripts/backfill-certificates.ts",
    "check:auth": "tsx scripts/check-auth.ts",
    "bench:reports": "tsx --require ./scripts/allow-server-only.cjs --env-file=.env scripts/bench-reports.ts",
    "perf:env": "tsx scripts/perf/env.ts",
    "perf:db": "tsx --env-file=.env.perf scripts/perf/db.ts",
    "perf:db:drop": "tsx --env-file=.env.perf scripts/perf/db.ts --drop",
    "perf:seed": "tsx --require ./scripts/allow-server-only.cjs --env-file=.env.perf scripts/seed-perf.ts",
    "perf:snapshot": "tsx --require ./scripts/allow-server-only.cjs --env-file=.env.perf scripts/perf-snapshot.ts",
    "perf:bench": "tsx --require ./scripts/allow-server-only.cjs --env-file=.env.perf scripts/bench-pages.ts",
    "perf:job": "tsx --require ./scripts/allow-server-only.cjs --env-file=.env.perf scripts/perf/job.ts",
    "demo:seed": "tsx --require ./scripts/allow-server-only.cjs --env-file=.env scripts/seed-demo.ts",
    "help:shots": "tsx --env-file=.env scripts/help/capture.ts",
    "test:env": "tsx scripts/test/env.ts",
    "test:seed": "tsx scripts/seed-test.ts",
    "test:e2e": "tsx scripts/test/check-port.ts && npm run test:seed && next build && playwright test",
    "test:e2e:ui": "tsx scripts/test/check-port.ts && npm run test:seed && playwright test --ui",
    "test:e2e:no-bunny": "E2E_NO_BUNNY=1 npm run test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.3.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/extension-underline": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "player.js": "^0.1.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/youtube": "^0.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx --require ./scripts/allow-server-only.cjs prisma/seed.ts"
  }
}
