# =============================================================================
# Kiểm thử e2e (Việc 31) — database RIÊNG elearning_test trong cùng container Postgres.
# Cách nhanh nhất: npm run test:env  (tự tạo .env.test từ .env, sinh AUTH_SECRET / CRON_SECRET riêng)
# Hoặc copy file này thành .env.test rồi điền mật khẩu Postgres thật + 2 khoá bí mật (KHÔNG commit .env.test).
# Mọi script test:* từ chối chạy nếu tên database không phải elearning_test.
# =============================================================================

DATABASE_URL="postgresql://elearning_admin:DoiMatKhauNay123@localhost:5432/elearning_test?schema=public"
AUTH_SECRET=
AUTH_URL=http://localhost:3200
APP_URL=http://localhost:3200
AUTH_TRUST_HOST=true
CRON_SECRET=
# Giả lập chạy sau proxy: mỗi tài khoản kiểm thử đăng nhập từ 1 IP riêng (X-Forwarded-For). Không có cờ tắt giới hạn tần suất.
TRUST_PROXY=true
# File tải lên trong lúc kiểm thử (không lẫn với uploads/ thật)
UPLOAD_DIR=./.e2e-uploads
# Bunny Stream GIẢ LẬP (e2e/mock-bunny, Việc 31B) — khoá ngẫu nhiên bất kỳ (KHÔNG dùng khoá thật), địa chỉ trỏ sang máy giả cổng 3201.
# npm run test:env tự thêm các dòng này. Chạy bộ kiểm thử KHÔNG có Bunny: npm run test:e2e:no-bunny
BUNNY_STREAM_LIBRARY_ID=123456
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_READONLY_KEY=
BUNNY_API_BASE=http://localhost:3201
BUNNY_TUS_ENDPOINT=http://localhost:3201/tusupload
BUNNY_EMBED_HOST=http://localhost:3201
