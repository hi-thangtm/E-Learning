# =============================================================================
# Copy file này thành .env rồi điền giá trị thật:   cp .env.example .env
# .env KHÔNG được commit lên GitHub (repo đang public).
# Mật khẩu: chỉ dùng chữ + số (ký tự đặc biệt như @ : / # làm hỏng DATABASE_URL)
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_USER=elearning_admin
POSTGRES_PASSWORD=DoiMatKhauNay123
POSTGRES_DB=elearning
POSTGRES_PORT=5432

# Dùng khi chạy "npm run dev" / "npx prisma ..." trực tiếp trên máy (ngoài Docker).
# Khi chạy trong Docker, docker-compose.yml tự đổi host thành "db".
DATABASE_URL="postgresql://elearning_admin:DoiMatKhauNay123@localhost:5432/elearning?schema=public"

# ---- pgAdmin ----
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=DoiMatKhauPgAdmin123
PGADMIN_PORT=5050

# ---- Next.js / Auth.js ----
APP_PORT=3000
# Tạo bằng lệnh:  openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---- Lưu file tải lên (ảnh bìa, PDF...) ----
# Thư mục gốc lưu file. Chạy trên máy: ./uploads (đã có trong .gitignore).
# Trong Docker: docker-compose.yml tự đặt /app/uploads (có volume, không mất khi build lại).
UPLOAD_DIR=./uploads

# ---- Bunny Stream (video) ----
# Bunny -> Stream -> chọn thư viện video:
#   - Library ID + API Key: mục "API"
#   - Token Key: mục "Security" -> bật "Embed view token authentication" -> "Token authentication key"
# Thiếu 1 trong 3 biến -> lựa chọn Bunny trong bài Video bị khoá ("Chưa cấu hình Bunny Stream").
# Các khoá này CHỈ dùng ở server, không bao giờ gửi về trình duyệt.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
