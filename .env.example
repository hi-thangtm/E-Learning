# =============================================================================
# File mẫu biến môi trường. Copy thành .env rồi điền giá trị thật:
#     cp .env.example .env
# KHÔNG đưa file .env lên GitHub (repo đang public).
# Mật khẩu chỉ nên dùng chữ + số (tránh @ : / # ?) để không phá DATABASE_URL.
# =============================================================================

# ---------------- Database (PostgreSQL) ----------------
POSTGRES_USER=elearning_admin
POSTGRES_PASSWORD=DoiMatKhauNay123
POSTGRES_DB=elearning
POSTGRES_PORT=5432

# Dùng khi chạy lệnh Prisma trực tiếp trên máy Mac (npx prisma migrate dev ...)
# Container "app" tự dùng địa chỉ db:5432 nên không cần sửa dòng này cho Docker.
DATABASE_URL=postgresql://elearning_admin:DoiMatKhauNay123@localhost:5432/elearning?schema=public

# ---------------- pgAdmin (chỉ dùng khi lập trình) ----------------
PGADMIN_EMAIL=admin@elearning.dev
PGADMIN_PASSWORD=DoiMatKhauNay123

# ---------------- Ứng dụng ----------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Tạo chuỗi bí mật bằng lệnh:  openssl rand -base64 32
AUTH_SECRET=

# ---------------- Bunny Stream (video bài giảng) ----------------
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# ---------------- Chỉ dùng trên VPS ----------------
# Tên miền trỏ về IP của VPS, ví dụ: elearning.congty.vn
# Chưa có tên miền thì để  :80  (chạy http bằng IP)
DOMAIN=:80

TZ=Asia/Ho_Chi_Minh

# ---------------- Tài khoản quản trị đầu tiên (dùng cho npx prisma db seed) ----------------
SEED_ADMIN_CODE=ADMIN
SEED_ADMIN_PASSWORD=DoiMatKhauNay123
